<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Alpha Ventures – Order Online</title>
<meta name="description" content="Alpha Ventures – home essentials, decor and accessories. Order online, we confirm on WhatsApp.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --primary:#0f4c81;
  --primary-dark:#0a3458;
  --accent:#f59e0b;
  --green:#22a559;
  --bg:#f5f7fb;
  --card:#ffffff;
  --text:#1f2937;
  --muted:#6b7280;
  --border:#e5e7eb;
  --radius:14px;
  --shadow:0 4px 16px rgba(15,76,129,.10);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Poppins',system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:var(--bg);color:var(--text);line-height:1.5;-webkit-tap-highlight-color:transparent}
img{max-width:100%;display:block}
button{font-family:inherit;cursor:pointer;border:none}

/* Header */
header{background:linear-gradient(135deg,var(--primary),var(--primary-dark));color:#fff;text-align:center;padding:22px 16px 20px}
header h1{font-size:1.7rem;letter-spacing:1.5px;font-weight:700}
header p{font-size:.9rem;opacity:.9;margin-top:2px}
header .loc{font-size:.78rem;opacity:.8;margin-top:6px}

/* Hero */
.hero{max-width:1100px;margin:18px auto 6px;padding:0 14px}
.hero-inner{border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);background:#dfe7f1}
.hero-inner img{width:100%;height:auto;max-height:480px;object-fit:cover;margin:0 auto}

/* Filters */
.filters{max-width:1100px;margin:16px auto 4px;padding:0 14px;display:flex;gap:8px;overflow-x:auto;scrollbar-width:none}
.filters::-webkit-scrollbar{display:none}
.filters button{flex:0 0 auto;padding:8px 18px;border-radius:999px;background:#fff;color:var(--primary);border:1.5px solid var(--primary);font-size:.85rem;font-weight:500;transition:.2s}
.filters button.active{background:var(--primary);color:#fff}

/* Products */
.section-title{max-width:1100px;margin:14px auto 0;padding:0 14px;font-size:1.15rem;font-weight:600}
.grid{max-width:1100px;margin:12px auto 120px;padding:0 14px;display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
@media(min-width:700px){.grid{grid-template-columns:repeat(3,1fr);gap:18px}}
@media(min-width:1000px){.grid{grid-template-columns:repeat(4,1fr)}}
.card{background:var(--card);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);display:flex;flex-direction:column;transition:transform .2s}
.card:hover{transform:translateY(-3px)}
.card .img{aspect-ratio:1/1;background:#eef2f7;overflow:hidden}
.card .img img{width:100%;height:100%;object-fit:cover}
.card .body{padding:10px 12px 12px;display:flex;flex-direction:column;flex:1}
.card .cat{font-size:.68rem;text-transform:uppercase;letter-spacing:.6px;color:var(--accent);font-weight:600}
.card h3{font-size:.82rem;font-weight:500;margin:3px 0;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;min-height:3.7em}
.card .desc{font-size:.74rem;color:var(--muted);margin-bottom:8px}
.card .row{margin-top:auto;display:flex;align-items:center;justify-content:space-between;gap:6px}
.price{font-weight:700;font-size:1.05rem;color:var(--primary)}
.add{background:var(--primary);color:#fff;padding:8px 12px;border-radius:10px;font-size:.78rem;font-weight:600;transition:.2s}
.add:active{transform:scale(.94)}
.add.added{background:var(--green)}
.empty{grid-column:1/-1;text-align:center;color:var(--muted);padding:40px 0}

/* Floating buttons */
.fab{position:fixed;right:16px;width:58px;height:58px;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 18px rgba(0,0,0,.25);z-index:50;transition:transform .2s}
.fab:active{transform:scale(.92)}
#cartBtn{bottom:20px;background:var(--accent);color:#fff}
#waBtn{bottom:92px;background:#25d366;color:#fff;text-decoration:none}
.fab svg{width:28px;height:28px;fill:currentColor}
#cartCount{position:absolute;top:-4px;right:-4px;background:#e11d48;color:#fff;font-size:.72rem;font-weight:700;min-width:22px;height:22px;border-radius:11px;display:flex;align-items:center;justify-content:center;padding:0 5px}
.bump{animation:bump .4s}
@keyframes bump{0%{transform:scale(1)}40%{transform:scale(1.25)}100%{transform:scale(1)}}

/* Modals */
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);display:none;align-items:flex-end;justify-content:center;z-index:100}
.overlay.open{display:flex;animation:fade .2s}
@keyframes fade{from{opacity:0}to{opacity:1}}
.sheet{background:#fff;width:100%;max-width:520px;max-height:92vh;border-radius:20px 20px 0 0;display:flex;flex-direction:column;animation:up .3s ease}
@keyframes up{from{transform:translateY(60px);opacity:.5}to{transform:none;opacity:1}}
@media(min-width:600px){.overlay{align-items:center}.sheet{border-radius:20px}}
.sheet-head{display:flex;justify-content:space-between;align-items:center;padding:16px 18px;border-bottom:1px solid var(--border)}
.sheet-head h2{font-size:1.1rem}
.close{background:#f1f5f9;width:34px;height:34px;border-radius:50%;font-size:1.2rem;color:var(--muted)}
.sheet-body{padding:14px 18px;overflow-y:auto;flex:1}
.sheet-foot{padding:14px 18px;border-top:1px solid var(--border)}

/* Cart items */
.item{display:flex;gap:10px;padding:10px 0;border-bottom:1px solid var(--border);animation:fade .25s}
.item img{width:62px;height:62px;border-radius:10px;object-fit:cover;background:#eef2f7;flex:0 0 62px}
.item .info{flex:1;min-width:0}
.item .n{font-size:.8rem;font-weight:500;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.item .p{font-size:.75rem;color:var(--muted);margin:2px 0 6px}
.qty{display:inline-flex;align-items:center;border:1.5px solid var(--border);border-radius:8px;overflow:hidden}
.qty button{width:30px;height:30px;background:#f8fafc;font-size:1.05rem;color:var(--primary);font-weight:700}
.qty span{min-width:32px;text-align:center;font-size:.85rem;font-weight:600}
.item .right{text-align:right;display:flex;flex-direction:column;justify-content:space-between;align-items:flex-end}
.item .sub{font-weight:700;font-size:.9rem}
.rm{background:none;color:#e11d48;font-size:.72rem;font-weight:500;text-decoration:underline}
.total-row{display:flex;justify-content:space-between;font-size:1.1rem;font-weight:700;margin-bottom:12px}
.note{font-size:.72rem;color:var(--muted);margin-bottom:10px}
.btn{width:100%;padding:13px;border-radius:12px;font-size:.95rem;font-weight:600;color:#fff;background:var(--green);transition:.2s}
.btn:active{transform:scale(.98)}
.btn:disabled{opacity:.6}
.btn.alt{background:#25d366;display:block;text-align:center;text-decoration:none;margin-top:10px}
.btn.ghost{background:#f1f5f9;color:var(--primary);margin-top:10px}

/* Form */
label{display:block;font-size:.8rem;font-weight:500;margin:12px 0 4px}
label small{color:var(--muted);font-weight:400}
input,textarea{width:100%;padding:11px 12px;border:1.5px solid var(--border);border-radius:10px;font:inherit;font-size:.9rem;outline:none}
input:focus,textarea:focus{border-color:var(--primary)}
textarea{resize:vertical;min-height:70px}
.mini{background:#f8fafc;border-radius:10px;padding:10px 12px;font-size:.78rem;margin-top:14px}
.mini b{color:var(--primary)}
.err{color:#e11d48;font-size:.78rem;margin-top:8px;display:none}

/* Confirmation */
.done{text-align:center;padding:10px 0 4px}
.done .tick{width:70px;height:70px;border-radius:50%;background:#dcfce7;color:var(--green);display:flex;align-items:center;justify-content:center;font-size:2.2rem;margin:0 auto 12px}
.done h3{font-size:1.2rem;margin-bottom:6px}
.done p{font-size:.88rem;color:var(--muted)}

footer{text-align:center;font-size:.75rem;color:var(--muted);padding:0 16px 130px;margin-top:-90px}
</style>
</head>
<body>

<header>
  <h1 id="shopName">ALPHA VENTURES</h1>
  <p id="shopTag">Quality home essentials &amp; décor, delivered to your door</p>
  <div class="loc">📞 +91 7457885578</div>
</header>

<section class="hero">
  <div class="hero-inner">
    <img src="https://i.ibb.co/RpwYvZnQ/Gemini-Generated-Image-z7vkcjz7vkcjz7vk-1.png" alt="Alpha Ventures – featured collection">
  </div>
</section>

<nav class="filters" id="filters" aria-label="Product categories"></nav>
<h2 class="section-title" id="sectionTitle">All Products</h2>
<main class="grid" id="grid"></main>
<footer>© <span id="yr"></span> Alpha Ventures · Orders are confirmed on WhatsApp before delivery</footer>

<!-- Floating buttons -->
<a class="fab" id="waBtn" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
  <svg viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
</a>
<button class="fab" id="cartBtn" aria-label="Open cart">
  <svg viewBox="0 0 24 24"><path d="M7 18a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm10 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zM1 2v2h2l3.600 7.600-1.400 2.400A2 2 0 0 0 7 17h12v-2H7.400l1.100-2h7.500a2 2 0 0 0 1.700-1l3.600-6.500A1 1 0 0 0 20.400 4H5.200l-.9-2H1z"/></svg>
  <span id="cartCount">0</span>
</button>

<!-- Cart modal -->
<div class="overlay" id="cartModal">
  <div class="sheet">
    <div class="sheet-head"><h2>🛒 Your Cart</h2><button class="close" data-close>×</button></div>
    <div class="sheet-body" id="cartItems"></div>
    <div class="sheet-foot" id="cartFoot">
      <div class="total-row"><span>Grand Total</span><span id="grandTotal">₹0</span></div>
      <p class="note">Final price &amp; availability will be confirmed by us on WhatsApp. No online payment needed.</p>
      <button class="btn" id="placeOrder">Place Order</button>
    </div>
  </div>
</div>

<!-- Checkout modal -->
<div class="overlay" id="checkoutModal">
  <div class="sheet">
    <div class="sheet-head"><h2>📦 Delivery Details</h2><button class="close" data-close>×</button></div>
    <form id="orderForm" style="display:flex;flex-direction:column;flex:1;min-height:0" novalidate>
      <div class="sheet-body">
        <label for="cName">Full Name *</label>
        <input id="cName" name="name" type="text" required autocomplete="name" placeholder="Your name">
        <label for="cPhone">Phone Number *</label>
        <input id="cPhone" name="phone" type="tel" required autocomplete="tel" inputmode="tel" placeholder="10-digit mobile number">
        <label for="cAddr">Delivery Address *</label>
        <textarea id="cAddr" name="address" required autocomplete="street-address" placeholder="House no., street, area, city, pincode"></textarea>
        <label for="cNote">Special Instructions <small>(optional)</small></label>
        <textarea id="cNote" name="instructions" placeholder="Anything we should know?"></textarea>
        <div class="mini">Order total: <b id="coTotal">₹0</b> · <span id="coItems">0</span> item(s)</div>
        <div class="err" id="formErr"></div>
      </div>
      <div class="sheet-foot">
        <button class="btn" type="submit" id="submitBtn">Confirm Order</button>
        <button class="btn ghost" type="button" data-back>← Back to cart</button>
      </div>
    </form>
  </div>
</div>

<!-- Confirmation modal -->
<div class="overlay" id="doneModal">
  <div class="sheet">
    <div class="sheet-head"><h2>Order Received</h2><button class="close" data-close>×</button></div>
    <div class="sheet-body">
      <div class="done">
        <div class="tick">✓</div>
        <h3>Order placed!</h3>
        <p id="doneMsg"></p>
        <a class="btn alt" id="doneWa" target="_blank" rel="noopener">💬 Message us on WhatsApp</a>
        <button class="btn ghost" data-close>Continue shopping</button>
      </div>
    </div>
  </div>
</div>

<script>
/* ============ CONFIG – EDIT HERE ============ */
const CONFIG = {
  shopName: "Alpha Ventures",
  whatsapp: "917457885578",                 // country code + number, no + or spaces
  ownerEmail: "k.alphaventures@gmail.com",  // (Formspree sends to the email you register with)
  formspreeId: "YOUR_FORM_ID",              // <-- paste your Formspree form ID here (e.g. "xyzabcde")
  currency: "₹"
};

/* ============ PRODUCTS – EDIT PRICES HERE ============ */
const PRODUCTS = [
  {
    id: 1,
    name: "6 In 1 Self Adhesive Wall Hooks, Heavy Duty Sticky Hooks for Hanging, Waterproof Transparent Adhesive Hooks for Wall, Wall Hangers for Hanging Kitchen Bathroom Bedroom Accessories Hook",
    price: 149,
    category: "Home & Kitchen",
    image: "https://i.ibb.co/6cT21GRq/a-there-is-a-product-n-1.jpg",
    desc: "Pack of 6 strong, waterproof, no-drill hooks"
  },
  {
    id: 2,
    name: "Evil Eye Bell Keychain with Antique Brass Finish for Keys and Bags, Antique Bell Evil Eye Keychain Decorative Key Ring for Men and Women, Blue Evil Eye Bell Keychain Metal Key Ring for Bags, Backpacks",
    price: 99,
    category: "Accessories",
    image: "https://i.ibb.co/V0VbbJXF/33.jpg",
    desc: "Antique brass bell keychain with blue evil eye"
  },
  {
    id: 3,
    name: "Wooden Door Chime Beech Wooden Brass Bell Dopamine Door Bell for Home, Decorative Magnetic Doorbell Dopamine Doorbell, Shopkeepers Door Chime",
    price: 249,
    category: "Home Décor",
    image: "https://i.ibb.co/Q1p2jfN/146-Door-Chimes-Bells.jpg",
    desc: "Magnetic wooden door chime with brass bells"
  }
];

/* ============ HELPERS ============ */
const $ = s => document.querySelector(s);
const fmt = n => CONFIG.currency + Number(n).toLocaleString('en-IN');
const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const PLACEHOLDER = "data:image/svg+xml;utf8," + encodeURIComponent("<svg xmlns='http://www.w3.org/2000/svg' width='400' height='400'><rect width='100%' height='100%' fill='#eef2f7'/><text x='50%' y='50%' fill='#9aa5b4' font-family='sans-serif' font-size='20' text-anchor='middle'>No image</text></svg>");

let cart = [];
try { cart = JSON.parse(localStorage.getItem('alpha_cart') || '[]'); } catch(e){ cart = []; }
cart = cart.filter(c => PRODUCTS.some(p => p.id === c.id));
let activeCat = 'All';

function saveCart(){ try{ localStorage.setItem('alpha_cart', JSON.stringify(cart)); }catch(e){} }
function getProduct(id){ return PRODUCTS.find(p => p.id === id); }
function cartTotal(){ return cart.reduce((t,c) => t + getProduct(c.id).price * c.qty, 0); }
function cartCount(){ return cart.reduce((t,c) => t + c.qty, 0); }

/* ============ RENDER PRODUCTS ============ */
function renderFilters(){
  const cats = ['All', ...new Set(PRODUCTS.map(p => p.category))];
  $('#filters').innerHTML = cats.map(c =>
    `<button class="${c===activeCat?'active':''}" data-cat="${esc(c)}">${esc(c)}</button>`).join('');
}
function renderProducts(){
  const list = activeCat === 'All' ? PRODUCTS : PRODUCTS.filter(p => p.category === activeCat);
  $('#sectionTitle').textContent = activeCat === 'All' ? 'All Products' : activeCat;
  $('#grid').innerHTML = list.length ? list.map(p => `
    <article class="card">
      <div class="img"><img src="${esc(p.image)}" alt="${esc(p.name)}" loading="lazy" onerror="this.onerror=null;this.src='${PLACEHOLDER}'"></div>
      <div class="body">
        <span class="cat">${esc(p.category)}</span>
        <h3 title="${esc(p.name)}">${esc(p.name)}</h3>
        <p class="desc">${esc(p.desc)}</p>
        <div class="row">
          <span class="price">${fmt(p.price)}</span>
          <button class="add" data-add="${p.id}">Add to Cart</button>
        </div>
      </div>
    </article>`).join('') : '<p class="empty">No products in this category.</p>';
}

/* ============ CART ============ */
function updateBadge(bump){
  const el = $('#cartCount');
  el.textContent = cartCount();
  if(bump){ el.classList.remove('bump'); void el.offsetWidth; el.classList.add('bump'); }
}
function renderCart(){
  const box = $('#cartItems');
  if(!cart.length){
    box.innerHTML = '<p class="empty" style="padding:40px 0;text-align:center;color:#6b7280">Your cart is empty.<br>Add something you like! 🛍️</p>';
    $('#cartFoot').style.display = 'none';
  } else {
    $('#cartFoot').style.display = '';
    box.innerHTML = cart.map(c => {
      const p = getProduct(c.id);
      return `<div class="item">
        <img src="${esc(p.image)}" alt="${esc(p.name)}" loading="lazy" onerror="this.onerror=null;this.src='${PLACEHOLDER}'">
        <div class="info">
          <div class="n">${esc(p.name)}</div>
          <div class="p">${fmt(p.price)} each</div>
          <div class="qty">
            <button data-dec="${p.id}" aria-label="Decrease">−</button>
            <span>${c.qty}</span>
            <button data-inc="${p.id}" aria-label="Increase">+</button>
          </div>
        </div>
        <div class="right">
          <span class="sub">${fmt(p.price * c.qty)}</span>
          <button class="rm" data-rm="${p.id}">Remove</button>
        </div>
      </div>`;
    }).join('');
  }
  $('#grandTotal').textContent = fmt(cartTotal());
  updateBadge(false);
}
function addToCart(id){
  const row = cart.find(c => c.id === id);
  if(row) row.qty++; else cart.push({id, qty:1});
  saveCart(); updateBadge(true);
}
function changeQty(id, d){
  const row = cart.find(c => c.id === id);
  if(!row) return;
  row.qty += d;
  if(row.qty <= 0) cart = cart.filter(c => c.id !== id);
  saveCart(); renderCart();
}
function removeItem(id){ cart = cart.filter(c => c.id !== id); saveCart(); renderCart(); }

/* ============ MODALS ============ */
function openModal(id){ $(id).classList.add('open'); document.body.style.overflow='hidden'; }
function closeAll(){ document.querySelectorAll('.overlay').forEach(o => o.classList.remove('open')); document.body.style.overflow=''; }
function showOnly(id){ document.querySelectorAll('.overlay').forEach(o => o.classList.remove('open')); openModal(id); }

/* ============ ORDER SUMMARY ============ */
function buildSummary(){
  const lines = cart.map((c,i) => {
    const p = getProduct(c.id);
    return `${i+1}. ${p.name}\n   Qty: ${c.qty} x ${fmt(p.price)} = ${fmt(p.price*c.qty)}`;
  });
  return lines.join('\n\n') + `\n\n--------------------\nGRAND TOTAL: ${fmt(cartTotal())}`;
}
function buildWhatsAppText(d, orderNo){
  const items = cart.map(c => {
    const p = getProduct(c.id);
    return `• ${p.name.split(',')[0]} – ${c.qty} x ${fmt(p.price)} = ${fmt(p.price*c.qty)}`;
  }).join('\n');
  return `Hello ${CONFIG.shopName}! I placed an order${orderNo?` (#${orderNo})`:''}.\n\n${items}\n\nTotal: ${fmt(cartTotal())}\n\nName: ${d.name}\nPhone: ${d.phone}\nAddress: ${d.address}` + (d.instructions?`\nNote: ${d.instructions}`:'');
}

/* ============ EVENTS ============ */
document.addEventListener('click', e => {
  const t = e.target;
  if(t.dataset.cat){ activeCat = t.dataset.cat; renderFilters(); renderProducts(); }
  if(t.dataset.add){
    addToCart(+t.dataset.add);
    t.textContent = '✓ Added'; t.classList.add('added');
    setTimeout(() => { t.textContent = 'Add to Cart'; t.classList.remove('added'); }, 900);
  }
  if(t.dataset.inc) changeQty(+t.dataset.inc, 1);
  if(t.dataset.dec) changeQty(+t.dataset.dec, -1);
  if(t.dataset.rm) removeItem(+t.dataset.rm);
  if(t.hasAttribute('data-close') || t.classList.contains('overlay')) closeAll();
  if(t.hasAttribute('data-back')){ renderCart(); showOnly('#cartModal'); }
});
document.addEventListener('keydown', e => { if(e.key === 'Escape') closeAll(); });

$('#cartBtn').onclick = () => { renderCart(); openModal('#cartModal'); };
$('#placeOrder').onclick = () => {
  if(!cart.length) return;
  $('#coTotal').textContent = fmt(cartTotal());
  $('#coItems').textContent = cartCount();
  $('#formErr').style.display = 'none';
  showOnly('#checkoutModal');
};

$('#orderForm').addEventListener('submit', async e => {
  e.preventDefault();
  const err = $('#formErr');
  const d = {
    name: $('#cName').value.trim(),
    phone: $('#cPhone').value.trim(),
    address: $('#cAddr').value.trim(),
    instructions: $('#cNote').value.trim()
  };
  const showErr = m => { err.textContent = m; err.style.display = 'block'; };
  if(!d.name || !d.phone || !d.address) return showErr('Please fill in name, phone and delivery address.');
  if(d.phone.replace(/\D/g,'').length < 10) return showErr('Please enter a valid 10-digit phone number.');
  if(!cart.length) return showErr('Your cart is empty.');
  err.style.display = 'none';

  const orderNo = 'AV' + Date.now().toString().slice(-6);
  const summary = buildSummary();
  const waText = buildWhatsAppText(d, orderNo);
  const btn = $('#submitBtn');
  btn.disabled = true; btn.textContent = 'Sending order…';

  // Email service: Formspree if an ID is set, otherwise FormSubmit (no signup – sends to ownerEmail)
  const useFormspree = CONFIG.formspreeId && CONFIG.formspreeId !== 'YOUR_FORM_ID';
  const endpoint = useFormspree
    ? 'https://formspree.io/f/' + CONFIG.formspreeId
    : 'https://formsubmit.co/ajax/' + CONFIG.ownerEmail;
  let emailed = false;

  const message =
`NEW ORDER #${orderNo} - ${CONFIG.shopName}
Date: ${new Date().toLocaleString('en-IN')}

CUSTOMER DETAILS
Name: ${d.name}
Phone: ${d.phone}
Address: ${d.address}
Instructions: ${d.instructions || 'None'}

ORDER ITEMS
${summary}`;

  try{
    const ctrl = new AbortController();
    const to = setTimeout(() => ctrl.abort(), 15000);
    const res = await fetch(endpoint, {
      method:'POST',
      headers:{'Content-Type':'application/json','Accept':'application/json'},
      signal: ctrl.signal,
      body: JSON.stringify({
        _subject: `New Order #${orderNo} from ${d.name} - ${fmt(cartTotal())}`,
        _captcha: 'false',
        _template: 'table',
        order_number: orderNo,
        customer_name: d.name,
        customer_phone: d.phone,
        delivery_address: d.address,
        special_instructions: d.instructions || 'None',
        order_items: summary,
        grand_total: fmt(cartTotal()),
        message: message
      })
    });
    clearTimeout(to);
    emailed = res.ok;
  }catch(ex){ emailed = false; }

  btn.disabled = false; btn.textContent = 'Confirm Order';

  // Never lose an order: if email fails, customer sends it via WhatsApp instead
  cart = []; saveCart(); updateBadge(false); $('#orderForm').reset();
  $('#doneMsg').textContent = emailed
    ? `Order placed! ${CONFIG.shopName} will contact you on WhatsApp to confirm. You can also tap below to send your order details on WhatsApp for faster confirmation.`
    : `Almost done! Please tap the green button below to send your order on WhatsApp so ${CONFIG.shopName} receives it and confirms with you.`;
  $('#doneWa').href = `https://wa.me/${CONFIG.whatsapp}?text=${encodeURIComponent(waText)}`;
  showOnly('#doneModal');
});

/* ============ INIT ============ */
$('#waBtn').href = `https://wa.me/${CONFIG.whatsapp}?text=${encodeURIComponent('Hello ' + CONFIG.shopName + '! I have a question.')}`;
$('#yr').textContent = new Date().getFullYear();
renderFilters(); renderProducts(); renderCart();
</script>
</body>
</html>
